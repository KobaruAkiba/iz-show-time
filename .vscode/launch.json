{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "iz-show-time (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define-from-file=environment.local",
        "--web-port=5555",
        "--web-browser-flag=--disable-web-security",
        "--web-browser-flag=--user-data-dir=${workspaceFolder}/.dart_tool/chrome-dev"
      ]
    }
  ]
}
